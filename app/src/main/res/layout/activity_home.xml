<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101818"
        android:padding="24dp"
        tools:context=".HomeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101818"
        android:padding="20dp">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TEXTO PARA SABER EL ESTADO DE CARGA DEL API -->
            <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/white"
                    android:text="Cargando"
                    android:textSize="15sp"/>


            <!-- TÍTULO DEL GÉNERO / INICIO DE SECCION -->

            <TextView
                    android:layout_marginTop="10dp"
                    android:id="@+id/tvGeneroTerror"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:text="Terror"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            <!-- SCROLLVIEW DEL GÉNERO -->
            <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:scrollbars="none">

                <!-- CONTENEDOR DEL GENERO -->
                <LinearLayout
                        android:id="@+id/contenedorTerror"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

            </HorizontalScrollView>


            <!-- TÍTULO DEL GÉNERO / INICIO DE SECCION -->

            <TextView
                    android:layout_marginTop="10dp"
                    android:id="@+id/tvGeneroRomance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:text="Romance"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            <!-- SCROLLVIEW DEL GÉNERO -->
            <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:scrollbars="none">

                <!-- CONTENEDOR DEL GENERO -->
                <LinearLayout
                        android:id="@+id/contenedorRomance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

            </HorizontalScrollView>

            <!-- TÍTULO DEL GÉNERO / INICIO DE SECCION -->

            <TextView
                    android:layout_marginTop="10dp"
                    android:id="@+id/tvGeneroComedia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:text="Comedia"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    android:textStyle="bold"/>

            <!-- SCROLLVIEW DEL GÉNERO -->
            <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:scrollbars="none">

                <!-- CONTENEDOR DEL GENERO -->
                <LinearLayout
                        android:id="@+id/contenedorComedia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>

            </HorizontalScrollView>



        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>