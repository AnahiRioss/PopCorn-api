<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:orientation="vertical"
              android:layout_width="155sp"
              android:layout_marginEnd="15dp"
              android:layout_height="wrap_content">


    <!-- Este es el contenido de las tarjetas para las peliculas -->

    <ImageView
            android:id="@+id/imgPosterPelicula"
            android:layout_width="155dp"
            android:layout_height="230dp"
            android:background="@color/black"
            android:scaleType="centerCrop" />

    <TextView
            android:id="@+id/tvNombrePelicula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nombre de la pelicula"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/tvCalificacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="20dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="⭐ 0.0"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#AEBABA"/>
</LinearLayout>